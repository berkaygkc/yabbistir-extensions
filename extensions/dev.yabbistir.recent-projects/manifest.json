{
  "id": "dev.yabbistir.recent-projects",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.3.0",
  "defaultLocale": "en",
  "name": "name",
  "description": "description",
  "icon": "sf:folder",
  "author": "Berkay Gökçe",
  "license": "MIT",
  "categories": ["developer", "productivity"],
  "permissions": ["exec"],
  "requires": {
    "tools": [
      { "name": "sqlite3", "install": "brew install sqlite" }
    ]
  },
  "preferences": [
    { "id": "home", "type": "folder", "title": "home.title", "default": "~" }
  ],
  "contributes": {
    "sources": [
      { "id": "projects", "title": "source.title", "actions": [
        { "id": "path", "kind": "text", "title": "path.title", "label": "path.label",
          "copyTitle": "path.copyTitle", "copied": "path.copied" },
        { "id": "open", "kind": "text", "title": "open.title", "label": "open.label" }
      ] }
    ]
  }
}
