{
  "id": "dev.yabbistir.github",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.3.0",
  "defaultLocale": "en",
  "name": "name",
  "description": "description",
  "icon": "sf:arrow.triangle.pull",
  "author": "Berkay Gökçe",
  "license": "MIT",
  "categories": ["developer", "links"],
  "permissions": ["exec"],
  "requires": {
    "tools": [
      { "name": "gh", "install": "brew install gh" }
    ]
  },
  "contributes": {
    "sources": [
      { "id": "work", "title": "source.title", "actions": [
        { "id": "link", "kind": "text", "title": "link.title", "label": "link.label",
          "copyTitle": "link.copyTitle", "copied": "link.copied" },
        { "id": "markdown", "kind": "text", "title": "markdown.title", "label": "markdown.label" }
      ] }
    ],
    "actions": [
      { "id": "reference", "title": "reference.title", "keywords": "reference.keywords", "input": "item",
        "accepts": { "kinds": ["link"], "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(pull|issues)/\\d+([/?#].*)?$" },
        "output": "text", "hint": true },
      { "id": "gist", "title": "gist.title", "keywords": "gist.keywords", "input": "item",
        "accepts": { "kinds": ["text", "code"] }, "output": "text",
        "variants": [
          { "id": "secret", "title": "gist.secret.title", "subtitle": "gist.secret.subtitle" },
          { "id": "public", "title": "gist.public.title", "subtitle": "gist.public.subtitle" }
        ] }
    ]
  }
}
