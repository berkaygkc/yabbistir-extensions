{
  "id": "dev.yabbistir.snippets",
  "version": "1.0.1",
  "apiVersion": 1,
  "minAppVersion": "0.4.0",
  "defaultLocale": "en",
  "name": "name",
  "description": "description",
  "icon": "sf:text.quote",
  "author": "Berkay Gökçe",
  "license": "MIT",
  "categories": ["productivity", "text"],
  "preferences": [
    { "id": "folder", "type": "folder", "title": "folder.title" },
    { "id": "file", "type": "text", "title": "file.title", "default": "snippets.md" }
  ],
  "contributes": {
    "sources": [
      { "id": "snippets", "title": "source.title", "actions": [
        { "id": "paste", "kind": "text", "title": "paste.title", "label": "paste.label",
          "copyTitle": "paste.copyTitle", "copied": "paste.copied" }
      ] }
    ]
  }
}
