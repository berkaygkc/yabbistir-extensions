  "categories": ["links"],
  "permissions": ["capture"],
  "contributes": {
    "captureRules": [
      { "id": "clean", "title": "clean.title", "description": "clean.description", "accepts": { "kinds": ["link", "text"], "pattern": "(?i)^\\s*https?://\\S+\\s*$" } }
    ]
  }
}
