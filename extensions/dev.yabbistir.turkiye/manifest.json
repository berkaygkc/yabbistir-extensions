{
  "id": "dev.yabbistir.turkiye",
  "version": "1.0.0",
  "apiVersion": 1,
  "defaultLocale": "en",
  "name": "name",
  "description": "description",
  "icon": "sf:textformat.123",
  "author": "Berkay Gökçe",
  "license": "MIT",
  "categories": ["text", "productivity"],
  "contributes": {
    "detectors": [
      { "id": "iban", "tag": "tag.iban",
        "accepts": { "kinds": ["text", "code"], "pattern": "(?i)^(?:IBAN:?[ \\u00A0]*)?[A-Z]{2}[0-9]{2}(?:[ \\u00A0]?[A-Z0-9]){11,30}$" },
        "validate": true, "preview": true },
      { "id": "tckn", "tag": "tag.tckn", "accepts": { "kinds": ["text", "code"], "pattern": "^[1-9][0-9]{10}$" },
        "validate": true, "preview": true },
      { "id": "vkn", "tag": "tag.vkn", "accepts": { "kinds": ["text", "code"], "pattern": "^[0-9]{10}$" },
        "validate": true, "preview": true },
      { "id": "phone", "tag": "tag.phone",
        "accepts": { "kinds": ["text"], "pattern": "^\\+?(?:[ ()\\-\\u00A0]*[0-9]){10,14}[ ()\\-\\u00A0]*$" },
        "validate": true, "preview": true }
    ],
    "actions": [
      { "id": "ibanSpaced", "title": "ibanSpaced.title", "subtitle": "ibanSpaced.subtitle", "keywords": "iban.keywords",
        "input": "item", "accepts": { "kinds": ["text", "code"], "tags": ["iban"] }, "output": "text", "hint": true, "priority": 1 },
      { "id": "ibanCompact", "title": "ibanCompact.title", "subtitle": "ibanCompact.subtitle", "keywords": "iban.keywords",
        "input": "item", "accepts": { "kinds": ["text", "code"], "tags": ["iban"] }, "output": "text", "hint": true, "priority": 1 },
      { "id": "phoneInternational", "title": "phoneInternational.title", "subtitle": "phoneInternational.subtitle",
        "keywords": "phone.keywords", "input": "item", "accepts": { "kinds": ["text"], "tags": ["phone"] },
        "output": "text", "hint": true, "priority": 1 },
      { "id": "phoneNational", "title": "phoneNational.title", "subtitle": "phoneNational.subtitle",
        "keywords": "phone.keywords", "input": "item", "accepts": { "kinds": ["text"], "tags": ["phone"] },
        "output": "text", "hint": true, "priority": 1 },
      { "id": "phoneE164", "title": "phoneE164.title", "subtitle": "phoneE164.subtitle",
        "keywords": "phone.keywords", "input": "item", "accepts": { "kinds": ["text"], "tags": ["phone"] },
        "output": "text", "hint": true, "priority": 1 },
      { "id": "track", "title": "track.title", "keywords": "track.keywords", "input": "item",
        "accepts": { "kinds": ["text"], "pattern": "(?i)^(?!(?:0090|90)[2-58][0-9]{9}$)(?:[0-9]{10}|[0-9]{12,22}|1Z[0-9A-Z]{16}|J{1,2}D[0-9]{10,22})$" },
        "output": "none",
        "variants": [
          { "id": "yurtici", "title": "yurtici.title", "subtitle": "yurtici.subtitle" },
          { "id": "aras", "title": "aras.title", "subtitle": "aras.subtitle" },
          { "id": "dhlecommerce", "title": "dhlecommerce.title", "subtitle": "dhlecommerce.subtitle" },
          { "id": "ups", "title": "ups.title", "subtitle": "ups.subtitle" },
          { "id": "dhl", "title": "dhl.title", "subtitle": "dhl.subtitle" }
        ] }
    ]
  }
}
