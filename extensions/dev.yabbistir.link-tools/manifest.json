{
  "id": "dev.yabbistir.link-tools",
  "version": "1.0.1",
  "apiVersion": 1,
  "minAppVersion": "0.4.0",
  "defaultLocale": "en",
  "name": "name",
  "description": "description",
  "icon": "sf:link",
  "author": "Berkay Gökçe",
  "license": "MIT",
  "categories": [
    "links"
  ],
  "permissions": [
    "network"
  ],
  "network": {
    "domains": [
      "is.gd",
      "v.gd"
    ]
  },
  "contributes": {
    "actions": [
      {
        "id": "expand",
        "title": "expand.title",
        "keywords": "expand.keywords",
        "input": "item",
        "accepts": {
          "kinds": [
            "link",
            "text"
          ],
          "tags": [
            "shortlink"
          ]
        },
        "output": "text"
      },
      {
        "id": "shorten",
        "title": "shorten.title",
        "keywords": "shorten.keywords",
        "input": "item",
        "accepts": {
          "kinds": [
            "link"
          ],
          "pattern": "(?i)^\\s*https?://[^\\s]+\\s*$"
        },
        "output": "text"
      }
    ],
    "detectors": [
      {
        "id": "shortlink",
        "tag": "tag",
        "accepts": {
          "kinds": [
            "link",
            "text"
          ],
          "pattern": "(?i)^\\s*https?://([a-z0-9-]+\\.)*(is\\.gd|v\\.gd)(:[0-9]+)?([/?#]|\\s*$)"
        },
        "validate": true
      }
    ]
  }
}
