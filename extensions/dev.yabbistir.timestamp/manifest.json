{
  "id": "dev.yabbistir.timestamp",
  "version": "1.0.0",
  "apiVersion": 1,
  "defaultLocale": "en",
  "minAppVersion": "0.4.0",
  "name": "name",
  "description": "description",
  "icon": "sf:clock",
  "author": "Berkay Gökçe",
  "license": "MIT",
  "categories": ["developer"],
  "preferences": [
    { "id": "zone", "type": "text", "title": "pref.zone", "default": "" }
  ],
  "contributes": {
    "detectors": [
      { "id": "timestamp", "tag": "tag",
        "accepts": { "kinds": ["text", "code"], "pattern": "^(?:[0-9]{10}|[0-9]{13}|[0-9]{16}|[0-9]{19}|[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}.{0,40}|(?:[A-Za-z]{3}, ?)?[0-9]{1,2} [A-Za-z]{3} [0-9]{4} [0-9]{2}:[0-9]{2}.{0,20})$" },
        "validate": true, "preview": true }
    ],
    "actions": [
      { "id": "toIso", "title": "toIso.title", "keywords": "toIso.keywords", "input": "item",
        "accepts": { "kinds": ["text", "code"], "tags": ["timestamp"] }, "output": "text", "hint": true, "priority": 4 },
      { "id": "toSeconds", "title": "toSeconds.title", "keywords": "toSeconds.keywords", "input": "item",
        "accepts": { "kinds": ["text", "code"], "tags": ["timestamp"] }, "output": "text", "hint": true, "priority": 3 },
      { "id": "toMilliseconds", "title": "toMilliseconds.title", "keywords": "toMilliseconds.keywords", "input": "item",
        "accepts": { "kinds": ["text", "code"], "tags": ["timestamp"] }, "output": "text", "hint": true, "priority": 2 },
      { "id": "toLocal", "title": "toLocal.title", "keywords": "toLocal.keywords", "input": "item",
        "accepts": { "kinds": ["text", "code"], "tags": ["timestamp"] }, "output": "text", "hint": true, "priority": 1 },
      { "id": "nowSeconds", "title": "nowSeconds.title", "keywords": "nowSeconds.keywords", "input": "none",
        "output": "text", "hint": true },
      { "id": "nowIso", "title": "nowIso.title", "keywords": "nowIso.keywords", "input": "none",
        "output": "text", "hint": true }
    ]
  }
}
