{
  "about": "A sensitive source with a secret and a text action.",
  "folder": "dev.example.sample",
  "manifest": {
    "id": "dev.example.sample",
    "version": "1.0.0",
    "apiVersion": 1,
    "defaultLocale": "en",
    "name": "name",
    "description": "description",
    "icon": "sf:number",
    "author": "example",
    "license": "MIT",
    "categories": [
      "productivity"
    ],
    "permissions": [
      "exec"
    ],
    "requires": {
      "tools": [
        {
          "name": "vault-cli",
          "install": "brew install vault-cli"
        }
      ]
    },
    "contributes": {
      "sources": [
        {
          "id": "vault",
          "title": "source.title",
          "sensitive": true,
          "actions": [
            {
              "id": "password",
              "kind": "secret",
              "title": "password.title",
              "label": "password.label"
            },
            {
              "id": "username",
              "kind": "text",
              "title": "username.title",
              "label": "username.label",
              "copyTitle": "username.copy",
              "copied": "username.copied"
            }
          ]
        }
      ]
    }
  },
  "locales": {
    "en": {
      "name": "Sample",
      "description": "A sample",
      "source.title": "Vault",
      "password.title": "Paste password",
      "password.label": "Password",
      "username.title": "Paste username",
      "username.label": "Username",
      "username.copy": "Copy username",
      "username.copied": "Username copied."
    }
  },
  "files": [
    "index.js"
  ]
}
