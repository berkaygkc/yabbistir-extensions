{
  "about": "failTitle on an action and on a variant are locale keys.",
  "folder": "dev.example.sample",
  "manifest": {
    "id": "dev.example.sample",
    "version": "1.0.0",
    "apiVersion": 1,
    "defaultLocale": "en",
    "name": "name",
    "description": "description",
    "icon": "sf:number",
    "author": "example",
    "license": "MIT",
    "categories": ["text"],
    "preferences": [{"id": "upper", "type": "toggle", "title": "upper", "default": false}],
    "contributes": {
      "actions": [
        {
          "id": "decode",
          "title": "decode.title",
          "keywords": "decode.keywords",
          "input": "item",
          "accepts": {"kinds": ["text"], "tags": ["base64"]},
          "output": "text",
          "hint": true,
          "priority": 2,
          "failTitle": "hello",
          "variants": [
            {"id": "a", "title": "decode.title", "failTitle": "encode.title"},
            {"id": "b", "title": "decode.title"}
          ]
        },
        {
          "id": "encode",
          "title": "encode.title",
          "keywords": "encode.keywords",
          "input": "item",
          "accepts": {"kinds": ["text", "code"]},
          "output": "text"
        }
      ],
      "detectors": [
        {
          "id": "base64",
          "tag": "tag",
          "accepts": {"kinds": ["text"], "pattern": "^[A-Za-z0-9+/]{8,}={0,2}$"},
          "validate": true,
          "preview": true,
          "suggests": ["decode"]
        }
      ]
    }
  },
  "locales": {
    "en": {
      "name": "Sample",
      "description": "A sample",
      "decode.title": "Decode",
      "decode.keywords": ["decode", "b64"],
      "encode.title": "Encode",
      "encode.keywords": ["encode"],
      "tag": "base64",
      "upper": "Uppercase",
      "hello": "Hello {name}"
    },
    "tr": {"decode.title": "Çöz", "decode.keywords": ["çöz"], "hello": "Merhaba {name}"}
  },
  "files": ["index.js"]
}
