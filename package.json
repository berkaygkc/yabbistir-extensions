{
  "name": "yabbistir-extensions",
  "private": true,
  "description": "Extensions for yabbistir, a clipboard history app for macOS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "validate": "node tools/validate.mjs",
    "new": "node tools/new.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/dev.mjs",
    "test": "node tools/test.mjs",
    "test:tools": "node --test \"tools/test/*.test.mjs\" \"packages/api/test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "docs": "node tools/docs.mjs",
    "catalog": "node tools/catalog.mjs",
    "pr-checks": "node tools/pr-checks.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "typescript": "7.0.2"
  }
}
