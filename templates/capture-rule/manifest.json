{
  "id": "{{id}}",
  "version": "1.0.0",
  "apiVersion": 1,
  "defaultLocale": "en",
  "name": "name",
  "description": "description",
  "icon": "sf:link",
  "author": "{{author}}",
  "license": "MIT",
  "categories": ["links"],
  "permissions": ["capture"],
  "contributes": {
    "captureRules": [
      { "id": "tidy", "title": "tidy.title", "description": "tidy.description",
        "accepts": { "kinds": ["link", "text"], "pattern": "(?i)^\\s*https?://\\S+\\s*$" } }
    ]
  }
}
